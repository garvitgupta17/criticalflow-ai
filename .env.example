
# Local development configuration
POSTGRES_PASSWORD=change-this-for-local-use
POSTGRES_PORT=5432

# API ports
M3_PORT=8000
M4_PORT=8001
M5_PORT=8002
DASHBOARD_PORT=8501

# Dashboard database
# Leave empty to use the local PostgreSQL container
DASHBOARD_DATABASE_URL=
DB_SSLMODE=prefer

# Optional IBM z/OSMF integration
ZOSMF_URL=
ZOSMF_USER=
ZOSMF_PASSWORD=
ZOSMF_VERIFY_TLS=true

# M2 to M3 authentication
API_TOKEN=
GEMINI_API_KEY=
